{
  "name": "@ehr/kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"${JUNIT_DIR:-.junit}/kernel.xml\" \"dist/**/*.test.js\"",
    "check:static": "pnpm run build && node dist/scope/check-static.js --signin-allow src/scope/ --skip src/scope/with-scope.ts src"
  },
  "dependencies": {
    "graphile-worker": "0.18.0",
    "pg": "8.23.1"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}

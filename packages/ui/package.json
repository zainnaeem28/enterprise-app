    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "jsdom": "31.0.0",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }

{
  "name": "enterprise-ehr",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @ehr/kernel --filter @ehr/contracts run build && pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test:boundary": "node eslint/test-boundary-fixture.mjs",
    "test:emulator": "pnpm -r --if-present run test:emulator"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}

# Sizing, topology, engine versions and network shape are deliberately NOT inputs:
# they come from profile.tf so that `loadtest` cannot drift from production
# (decision-log HEAAA-586 D-1). Only identity, run lifetime, certificates, images
# and cost ceilings vary.

variable "run_id" {
  description = "Unique id of this load run (for example 20261110-01). Part of every resource name so successive runs never collide (final snapshots, buckets)."
  type        = string
  validation {
    condition     = can(regex("^[a-z0-9][a-z0-9-]{2,23}$", var.run_id))
    error_message = "run_id is 3-24 characters: lower-case letters, digits, hyphen."
  }
}

variable "owner" {
  description = "Person or agent role accountable for the run (tag `owner`)."
  type        = string
  validation {
    condition     = length(var.owner) > 0
    error_message = "owner is required."
  }
}

variable "expires_at" {
  description = "RFC 3339 UTC time after which the environment must not exist (tag `ttl`). The pipeline sets it to start + at most 24 h; the reaper in tests/load/harness destroys anything past it."
  type        = string
  validation {
    condition     = can(formatdate("YYYY", var.expires_at))
    error_message = "expires_at must be an RFC 3339 timestamp such as 2026-11-11T08:00:00Z."
  }
  validation {
    condition     = !can(formatdate("YYYY", var.expires_at)) || timecmp(var.expires_at, timeadd(plantimestamp(), "24h")) <= 0
    error_message = "expires_at must be at most 24 hours after the plan time (decision-log D-1)."
  }
}

variable "cidr_block" {
  description = "VPC range. Must not overlap production (10.10/16), recovery (10.11/16), staging (10.20/16) or marketing (10.30/16)."
  type        = string
  default     = "10.40.0.0/16"
  validation {
    condition     = !contains(["10.10.0.0/16", "10.11.0.0/16", "10.20.0.0/16", "10.30.0.0/16"], var.cidr_block)
    error_message = "cidr_block overlaps another environment."
  }
}

variable "flow_log_destination_arn" {
  description = "Flow-log bucket ARN (log-archive account). No VPC without flow logs."
  type        = string
}

variable "alb_certificate_arn" {
  description = "ACM certificate covering the loadtest portal hosts and integrations host. Never the production certificate."
  type        = string
}

variable "cloudfront_certificate_arn" {
  description = "ACM certificate in us-east-1 covering the three loadtest portal hosts."
  type        = string
}

variable "portal_hosts" {
  description = "Loadtest-only host names for the patient, staff and pharmacy portals, keyed patient, staff, pharmacy. Must not be production host names."
  type        = map(string)
  validation {
    condition     = toset(keys(var.portal_hosts)) == toset(["patient", "staff", "pharmacy"])
    error_message = "portal_hosts needs exactly the keys patient, staff, pharmacy."
  }
}

variable "integrations_host" {
  description = "Loadtest-only machine-client host (stubs behind it, no real integrations)."
  type        = string
}

variable "origin_verify_secret" {
  description = "Per-run shared value for CloudFront-to-ALB. Generated by the pipeline, at least 32 characters, never reused from another environment, never committed."
  type        = string
  sensitive   = true
  validation {
    condition     = length(var.origin_verify_secret) >= 32
    error_message = "origin_verify_secret must be at least 32 characters."
  }
}

variable "access_logs_bucket" {
  description = "Log-archive bucket for ALB access logs."
  type        = string
}

variable "cloudfront_logs_bucket_domain" {
  description = "Log bucket domain for CloudFront logs."
  type        = string
}

variable "waf_log_group_arn_cloudfront" {
  type = string
}

variable "waf_log_group_arn_regional" {
  type = string
}

variable "execution_role_arn" {
  description = "Loadtest task execution role. Not the production role."
  type        = string
}

variable "services" {
  description = "api and worker images (digest-pinned, the same digests as the release candidate under test) and loadtest-only task roles. Counts and sizes are NOT set here; they come from profile.tf."
  type = map(object({
    image         = string
    task_role_arn = string
  }))
  validation {
    condition     = toset(keys(var.services)) == toset(["api", "worker"])
    error_message = "services needs api and worker."
  }
}

variable "seeder" {
  description = "Synthetic-data generator task. Image by digest; it writes only synthetic rows to the loadtest database."
  type = object({
    image         = string
    task_role_arn = string
    seed          = number
    counts        = map(number)
  })
  validation {
    condition     = can(regex("@sha256:[0-9a-f]{64}$", var.seeder.image))
    error_message = "seeder image must be referenced by sha256 digest."
  }
}

variable "run_cost_ceiling_usd" {
  description = "Per-run ceiling (decision-log D-1: estimated hourly production-equivalent rate x 8 h). The concrete value and its price-list basis are recorded in the plan artifact."
  type        = number
  validation {
    condition     = var.run_cost_ceiling_usd > 0
    error_message = "run_cost_ceiling_usd must be positive."
  }
}

variable "budget_notification_emails" {
  description = "Recipients of budget alarms. Addresses come from the pipeline, not from this repository."
  type        = list(string)
  validation {
    condition     = length(var.budget_notification_emails) > 0
    error_message = "At least one recipient is required."
  }
}

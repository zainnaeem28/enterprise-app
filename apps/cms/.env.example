# CMS runtime settings (marketing account only). Real values come from the marketing-account secret store, never from
# this file or the repository. The CMS refuses to start if any production-database variable is present
# (DATABASE_URL, PG*, ...) or if CMS_DATABASE_URL does not use a dedicated CMS role.
NODE_ENV=production
CMS_DATABASE_URL=postgres://cms_app:CHANGE_ME@cms-db.marketing.internal:5432/cms
PAYLOAD_SECRET=            # >= 32 random characters
CMS_PREVIEW_SECRET=        # >= 32 random characters; shared with the brand site; must differ from PAYLOAD_SECRET
CMS_PUBLIC_URL=https://cms.example.org
CMS_SITE_PREVIEW_URL=https://www.example.org
CMS_PREVIEW_TTL_SECONDS=900
CMS_SESSION_TTL_SECONDS=28800
# Separate OAuth client for the marketing group only (not a portal client).
CMS_GOOGLE_CLIENT_ID=
CMS_GOOGLE_CLIENT_SECRET=
CMS_GOOGLE_HOSTED_DOMAIN=example.org
# Comma-separated marketing-group member e-mails. Removing a person here ends their access on the next request.
CMS_ALLOWED_EMAILS=

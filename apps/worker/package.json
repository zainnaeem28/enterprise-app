{
  "name": "@ehr/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync-task-types": "node dist/sync-task-types-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"${JUNIT_DIR:-.junit}/worker.xml\" \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@ehr/kernel": "workspace:*",
    "graphile-worker": "0.18.0",
    "pg": "8.23.1"
  }
}
